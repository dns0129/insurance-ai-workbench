PORT=4387
HOST=127.0.0.1
# 当前是本机模拟登录，请勿作为正式身份认证直接对外开放。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 填写兼容 Chat Completions 的服务根地址，如 https://your-provider.example/v1
# 未配置时返回明确标注的模拟分析；密钥仅由后端读取。

# 团队知识助手（与上面的经营分析配置独立）
# 开发：默认使用 PATH 中的 Pi；可指定项目内 CLI 和独立的 Pi 认证配置目录。
# PI_AGENT_BIN=pi
# PI_AGENT_PROVIDER=openai
# PI_AGENT_MODEL=gpt-6.1-sol
# PI_CODING_AGENT_DIR=.tools/pi-agent
# KNOWLEDGE_PYTHON=.venv-knowledge/bin/python3
#
# 生产：NODE_ENV=production 会强制使用 DeepSeek 并要求正式账号配置。
# NODE_ENV=production
# WORKBENCH_PUBLIC_ORIGIN=https://team.example.com
# WORKBENCH_ACCOUNTS_FILE=/path/to/private/accounts.json
# WORKBENCH_DB_PATH=/path/to/persistent/team.sqlite
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_API_KEY=
